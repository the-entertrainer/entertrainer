# Server-only. Never commit real keys.
# Local: copy to .env. Production: Vercel → Settings → Environment Variables.
GROQ_API_KEY=
# Optional override (default groq/compound — best free-tier one-shot long articles)
GROQ_MODEL=groq/compound
GEMINI_API_KEY=
# Optional override (default gemini-3.5-flash-lite — reliable JSON, low overhead)
GEMINI_MODEL=gemini-3.5-flash-lite
