# Server-only. Never commit real keys.
# Local: copy to .env. Production: Vercel → Settings → Environment Variables.
GROQ_API_KEY=
# Optional override (default groq/compound — best free-tier one-shot long articles)
GROQ_MODEL=groq/compound
GEMINI_API_KEY=
# Optional override (default gemini-3.5-flash-lite — reliable JSON, low overhead)
GEMINI_MODEL=gemini-3.5-flash-lite

# Persist /compose publishes to GitHub (required on Vercel). PAT with contents:write
# on the-entertrainer/entertrainer. Prefer COMPOSE_GITHUB_TOKEN; GITHUB_TOKEN also works.
COMPOSE_GITHUB_TOKEN=
# GITHUB_TOKEN=
# Optional overrides:
# COMPOSE_GITHUB_REPO=the-entertrainer/entertrainer
# COMPOSE_GITHUB_BRANCH=main

# Optional — Elevate compose image sources (server-only; never commit real keys)
# Commons / Openverse needs no key. Gemini images reuse GEMINI_API_KEY.
# Gamma standalone images: POST https://public-api.gamma.app/v1.0/images (header X-API-KEY).
GAMMA_API_KEY=
# Optional override for Gemini image model (default gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image


# Optional stronger gate for /api/compose/* writes (defaults to compose page keyword if unset)
COMPOSE_API_SECRET=
